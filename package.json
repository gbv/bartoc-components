{
  "name": "@gbv/bartoc-components",
  "version": "0.6.0",
  "description": "Shared Vue components, design tokens, and CSS utilities for BARTOC applications.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbv/bartoc-components.git"
  },
  "bugs": {
    "url": "https://github.com/gbv/bartoc-components/issues"
  },
  "homepage": "https://github.com/gbv/bartoc-components#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "main": "./dist/bartoc-components.umd.cjs",
  "module": "./dist/bartoc-components.js",
  "exports": {
    ".": {
      "import": "./dist/bartoc-components.js",
      "require": "./dist/bartoc-components.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.0",
    "eslint-config-gbv": "~2.7.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.18",
    "vue": "^3.5.44"
  }
}
